# Writes go to this VM's vmagent, queries to this VM's storage; each moves to
# the other VM's when this one's is down.
# Two accounts: the writer may only write (collectors), the reader may only
# query (ai-o11y). %{...} is filled from vmauth's environment.
users:
  - username: "%{VMAUTH_WRITER_USERNAME}"
    password: "%{VMAUTH_WRITER_PASSWORD}"
    url_map:
      - src_paths: ["/opentelemetry/.*", "/api/v1/write"]
        url_prefix:
          - http://${SELF_ADDR}:8429
          - http://${PEER_ADDR}:8429
        load_balancing_policy: first_available
  - username: "%{VMAUTH_READER_USERNAME}"
    password: "%{VMAUTH_READER_PASSWORD}"
    url_map:
      - src_paths: ["/api/v1/query", "/api/v1/query_range", "/api/v1/series", "/api/v1/labels", "/api/v1/label/.+/values"]
        url_prefix:
          - http://${SELF_ADDR}:8428
          - http://${PEER_ADDR}:8428
        load_balancing_policy: first_available
