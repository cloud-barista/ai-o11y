# One VM of the three. Copy to .env on each VM: the same values everywhere
# but SELF_ADDR.

# This VM's address, and the three VMs' (one of them is SELF_ADDR).
SELF_ADDR=10.0.0.11
VM1_ADDR=10.0.0.11
VM2_ADDR=10.0.0.12
VM3_ADDR=10.0.0.13

# Image version of the cluster components (the -cluster images) and vmauth.
VM_VERSION=v1.155.0

# vmstorage: how long samples are kept, and the deduplication interval, which
# must equal the collectors' collection interval so a sample written twice
# collapses into one.
VM_RETENTION=15d
VM_DEDUP_INTERVAL=30s

# How many vmstorages hold each sample. With 2 of 3, one VM may be down
# without losing writes or queries.
VM_REPLICATION_FACTOR=2

# Whether OTLP scope metadata (the collector component that produced a series
# and its version, scope.name and scope.version) is added to every series as
# labels. Off here, as Prometheus does by default: with it on, a collector
# upgrade changes scope.version and starts new series. VictoriaMetrics' own
# default is on.
VM_OTLP_SCOPE_LABELS=false

# vmauth accounts: the writer for collectors, the reader for ai-o11y. Change
# the passwords before exposing vmauth anywhere.
VMAUTH_WRITER_USERNAME=writer
VMAUTH_WRITER_PASSWORD=change-me-writer
VMAUTH_READER_USERNAME=reader
VMAUTH_READER_PASSWORD=change-me-reader
