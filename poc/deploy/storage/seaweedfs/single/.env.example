# Image versions.
SEAWEEDFS_VERSION=4.51
MARIADB_VERSION=11.4

# SeaweedFS: copies of every volume. 001 is two copies on different servers of
# the same rack; 010 would ask for different racks, 100 different data
# centers.
SEAWEEDFS_REPLICATION=001
# Size a volume grows to before a new one is started.
SEAWEEDFS_VOLUME_SIZE_MB=1024

# Bucket Thanos writes blocks to, and the S3 account of the filers' S3
# gateways (one admin key; the gateways refuse requests without it).
S3_BUCKET=thanos
S3_ACCESS_KEY=thanos
S3_SECRET_KEY=change-me-s3

# MariaDB holding the filer metadata. Change the passwords before using this
# anywhere but a test host.
MARIADB_ROOT_PASSWORD=change-me-root
SEAWEEDFS_DB_USER=seaweedfs
SEAWEEDFS_DB_PASSWORD=change-me-seaweedfs
