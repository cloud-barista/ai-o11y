{
    "swagger": "2.0",
    "info": {
        "description": "Monitoring control plane for AI-MCMP: monitoring targets, collector configuration and metric queries over a Prometheus-family backend.",
        "title": "AI-MCMP AI-O11y Service (Prototype)",
        "contact": {},
        "license": {
            "name": "Apache 2.0",
            "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
        },
        "version": "0.1.0"
    },
    "basePath": "/aio11y",
    "paths": {
        "/metrics": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "List the metric catalog: the common fields, named and meant as OpenTelemetry names them, and the fields of one collector's own, each with the attribute that splits it and, for a field no collector provides yet, the reason.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Monitoring] Metrics"
                ],
                "summary": "List metrics",
                "operationId": "GetAllMetrics",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.MetricListResp"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong bearer token",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/query": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Query one metric over targets named by id or selected by their attributes, as one value per series or as a graph from start to end. The answer carries the series and the targets they belong to.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Monitoring] Metrics"
                ],
                "summary": "Query a metric",
                "operationId": "PostQuery",
                "parameters": [
                    {
                        "description": "Query",
                        "name": "queryReq",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.QueryReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.QueryResp"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong bearer token",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "404": {
                        "description": "Unknown metric or target",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "422": {
                        "description": "Metric is not supported",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "502": {
                        "description": "The metrics backend did not answer",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/readyz": {
            "get": {
                "description": "Report whether the service finished initialization and can accept requests",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Health] Service Health"
                ],
                "summary": "Check service readiness",
                "operationId": "GetReadyz",
                "responses": {
                    "200": {
                        "description": "Service is ready",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "503": {
                        "description": "Service is still initializing",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/targets": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "List the registered targets. Every query parameter is a condition on an attribute, all of which must match exactly: a common field (kind, name, provider, region, os, gpuCount, gpuModel) or a platform attribute such as nsId, infraId or nodeId.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Monitoring] Targets"
                ],
                "summary": "List targets",
                "operationId": "GetAllTargets",
                "parameters": [
                    {
                        "type": "string",
                        "description": "CB-Tumblebug namespace",
                        "name": "nsId",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "CB-Tumblebug Infra",
                        "name": "infraId",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.TargetListResp"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong bearer token",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Register a target when its agent is installed. The body names the node as ai-app names a deployment target and carries its description from CB-Tumblebug; without uid the description is read from CB-Tumblebug. Registering a target again replaces its description.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Monitoring] Targets"
                ],
                "summary": "Register a target",
                "operationId": "PostTarget",
                "parameters": [
                    {
                        "description": "Target to register",
                        "name": "targetReq",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.TargetReq"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.TargetInfo"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong bearer token",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "404": {
                        "description": "The node is not in CB-Tumblebug",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "422": {
                        "description": "Kind is not supported",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "502": {
                        "description": "CB-Tumblebug did not answer",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/targets/sync": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Bring the target table in step with CB-Tumblebug: describe every listed target again, and delete a target missing from the listing only when CB-Tumblebug answers that it is gone. Targets are never added here; they are registered at agent install. If the listing fails, nothing changes.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Monitoring] Targets"
                ],
                "summary": "Sync targets with the management platform",
                "operationId": "PostTargetSync",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.TargetSyncResp"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong bearer token",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "409": {
                        "description": "A sync is already running",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "502": {
                        "description": "The management platform could not be listed; nothing changed",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/targets/{targetId}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Get one registered target by its id.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Monitoring] Targets"
                ],
                "summary": "Get a target",
                "operationId": "GetTarget",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Target id (CB-Tumblebug node Uid)",
                        "name": "targetId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.TargetInfo"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong bearer token",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            },
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Delete a registered target, as when its agent is removed. Its stored series stay in the backend.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Monitoring] Targets"
                ],
                "summary": "Delete a target",
                "operationId": "DeleteTarget",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Target id (CB-Tumblebug node Uid)",
                        "name": "targetId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong bearer token",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/targets/{targetId}/collectorConfig": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Render the OpenTelemetry Collector configuration the target's agent runs: the collectors that apply to it, its entity_id stamped on every series, and the metrics backend to send them to.",
                "produces": [
                    "application/yaml"
                ],
                "tags": [
                    "[Monitoring] Targets"
                ],
                "summary": "Get a target's collector configuration",
                "operationId": "GetTargetCollectorConfig",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Target id (CB-Tumblebug node Uid)",
                        "name": "targetId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Collector configuration (YAML)",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong bearer token",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        },
        "/targets/{targetId}/metrics": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "List the metric catalog as it stands for one target: which fields it has, from the collectors that run on it, and which it does not, with the reason.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "[Monitoring] Metrics"
                ],
                "summary": "List a target's metrics",
                "operationId": "GetTargetMetrics",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Target id (CB-Tumblebug node Uid)",
                        "name": "targetId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.TargetMetricListResp"
                        }
                    },
                    "401": {
                        "description": "Missing or wrong bearer token",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/model.SimpleMsg"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.AttributeInfo": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "example": "cpu.mode"
                },
                "values": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "model.MetricInfo": {
            "type": "object",
            "properties": {
                "area": {
                    "type": "string",
                    "example": "cpu"
                },
                "attribute": {
                    "description": "Attribute splits the field: a query names it in where or splitBy.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/model.AttributeInfo"
                        }
                    ]
                },
                "description": {
                    "type": "string",
                    "example": "Share of CPU time in each cpu.mode. Without one, the share not idle."
                },
                "dimension": {
                    "description": "Dimension is the attribute that splits the field within a target, such\nas system.device.name; within collapses it.",
                    "type": "string",
                    "example": ""
                },
                "gap": {
                    "type": "string",
                    "example": ""
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "gauge",
                        "rate",
                        "info"
                    ],
                    "example": "rate"
                },
                "name": {
                    "type": "string",
                    "example": "system.cpu.utilization"
                },
                "requires": {
                    "description": "Requires lists what a target needs to have the field, such as \"os:linux\".",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "schema": {
                    "description": "Schema is empty for a common field and names the collector otherwise.",
                    "type": "string",
                    "example": ""
                },
                "supported": {
                    "description": "Supported is false when no collector provides the field yet; Gap says why.",
                    "type": "boolean",
                    "example": true
                },
                "unit": {
                    "type": "string",
                    "example": "1"
                },
                "zeroFill": {
                    "description": "ZeroFill is true when a query can take a missing value as 0 (fillZero).",
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "model.MetricListResp": {
            "type": "object",
            "properties": {
                "metrics": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.MetricInfo"
                    }
                }
            }
        },
        "model.PointInfo": {
            "type": "object",
            "properties": {
                "t": {
                    "type": "string"
                },
                "v": {
                    "type": "number"
                }
            }
        },
        "model.QueryReq": {
            "type": "object",
            "properties": {
                "across": {
                    "description": "Across combines the targets with fn, keeping the groupBy attributes.",
                    "type": "string",
                    "example": ""
                },
                "end": {
                    "type": "string"
                },
                "fillZero": {
                    "description": "FillZero takes a missing value as 0 for a metric whose collector does\nnot send zeros (MetricInfo.zeroFill), for targets otherwise reporting.",
                    "type": "boolean",
                    "example": false
                },
                "groupBy": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "metric": {
                    "description": "Metric and Schema name the catalog field (see GET /metrics); Schema is\nempty for a common field.",
                    "type": "string",
                    "example": "system.cpu.utilization"
                },
                "schema": {
                    "type": "string",
                    "example": ""
                },
                "selector": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "splitBy": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "start": {
                    "type": "string"
                },
                "step": {
                    "description": "Step makes a graph from start to end; empty asks for one value at end\n(now when end is empty).",
                    "type": "string",
                    "example": "1m"
                },
                "targetIds": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "topK": {
                    "$ref": "#/definitions/model.TopKReq"
                },
                "where": {
                    "description": "Where keeps the value of the field's attribute, such as\n{\"cpu.mode\": \"user\"}; SplitBy gives one series per value of it, such as\n[\"cpu.mode\"]. Without either the field answers its default value.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "windowFn": {
                    "description": "Window aggregates each series over the last windowRange with\nwindowFn: avg, min, max, sum, count or last.",
                    "type": "string",
                    "example": ""
                },
                "windowRange": {
                    "type": "string",
                    "example": ""
                },
                "within": {
                    "description": "Within collapses the field's dimension (devices, mount points) inside\neach target with fn: avg, min, max, sum or count.",
                    "type": "string",
                    "example": ""
                }
            }
        },
        "model.QueryResp": {
            "type": "object",
            "properties": {
                "series": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.SeriesInfo"
                    }
                },
                "targets": {
                    "description": "Targets describes, by id, the targets the series carry an entity_id of.",
                    "type": "object",
                    "additionalProperties": {
                        "$ref": "#/definitions/model.TargetInfo"
                    }
                }
            }
        },
        "model.SeriesInfo": {
            "type": "object",
            "properties": {
                "labels": {
                    "description": "Labels are entity_id and the attributes the series is split by, by\ntheir OpenTelemetry names.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "points": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.PointInfo"
                    }
                }
            }
        },
        "model.SimpleMsg": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Service is ready"
                }
            }
        },
        "model.TargetInfo": {
            "type": "object",
            "properties": {
                "attributes": {
                    "description": "Attributes are the platform attributes, such as nsId, infraId and nodeId.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "gpuCount": {
                    "type": "integer",
                    "example": 1
                },
                "gpuModel": {
                    "type": "string",
                    "example": "NVIDIA T4"
                },
                "id": {
                    "description": "ID is the target's key: the management platform's own key for it, the\nCB-Tumblebug node Uid, and the entity_id its series carry.",
                    "type": "string",
                    "example": "d44ikdomt0tac4ejrmmg"
                },
                "kind": {
                    "type": "string",
                    "example": "vm"
                },
                "name": {
                    "type": "string",
                    "example": "web-1"
                },
                "os": {
                    "type": "string",
                    "example": "linux"
                },
                "provider": {
                    "type": "string",
                    "example": "aws"
                },
                "region": {
                    "type": "string",
                    "example": "ap-northeast-2"
                }
            }
        },
        "model.TargetListResp": {
            "type": "object",
            "properties": {
                "targets": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.TargetInfo"
                    }
                }
            }
        },
        "model.TargetMetricInfo": {
            "type": "object",
            "properties": {
                "area": {
                    "type": "string",
                    "example": "cpu"
                },
                "attribute": {
                    "$ref": "#/definitions/model.AttributeInfo"
                },
                "dimension": {
                    "type": "string",
                    "example": ""
                },
                "name": {
                    "type": "string",
                    "example": "system.cpu.utilization"
                },
                "reason": {
                    "type": "string",
                    "example": ""
                },
                "schema": {
                    "type": "string",
                    "example": ""
                },
                "supported": {
                    "description": "Supported is whether the target has the field; Reason says why not.",
                    "type": "boolean",
                    "example": true
                },
                "unit": {
                    "type": "string",
                    "example": "1"
                }
            }
        },
        "model.TargetMetricListResp": {
            "type": "object",
            "properties": {
                "metrics": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.TargetMetricInfo"
                    }
                },
                "targetId": {
                    "type": "string",
                    "example": "d44ikdomt0tac4ejrmmg"
                }
            }
        },
        "model.TargetReq": {
            "type": "object",
            "required": [
                "infraId",
                "kind",
                "nodeId",
                "nsId"
            ],
            "properties": {
                "attributes": {
                    "description": "Attributes are further platform attributes to select the target by.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "gpuCount": {
                    "type": "integer",
                    "example": 1
                },
                "gpuModel": {
                    "type": "string",
                    "example": "NVIDIA T4"
                },
                "infraId": {
                    "type": "string",
