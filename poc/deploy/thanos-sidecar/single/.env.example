# Prometheus and Thanos, and below them the object storage the included
# SeaweedFS compose file reads (the same settings as
# storage/seaweedfs/single/.env.example).

# Image versions.
PROMETHEUS_VERSION=v3.16.0
THANOS_VERSION=v0.42.5
SEAWEEDFS_VERSION=4.51
MARIADB_VERSION=11.4

# Host ports: the Querier ai-o11y queries, and the two Prometheus replicas
# collectors write to.
THANOS_QUERY_PORT=10902
PROMETHEUS_1_PORT=9090
PROMETHEUS_2_PORT=9091

# How long each Prometheus keeps blocks on its own disk; the bucket keeps them
# after the Sidecar uploads them.
PROMETHEUS_RETENTION=6h

# Thanos Compactor: how long the bucket keeps each resolution (0d = forever).
COMPACT_RETENTION_RAW=30d
COMPACT_RETENTION_5M=90d
COMPACT_RETENTION_1H=1y

# SeaweedFS: copies of every volume. 001 is two copies on different servers of
# the same rack; 010 would ask for different racks, 100 different data
# centers.
SEAWEEDFS_REPLICATION=001
# Size a volume grows to before a new one is started.
SEAWEEDFS_VOLUME_SIZE_MB=1024

# Bucket Thanos writes blocks to, and the S3 account of the filers' S3
# gateways (one admin key; the gateways refuse requests without it).
S3_BUCKET=thanos
S3_ACCESS_KEY=thanos
S3_SECRET_KEY=change-me-s3

# MariaDB holding the filer metadata. Change the passwords before using this
# anywhere but a test host.
MARIADB_ROOT_PASSWORD=change-me-root
SEAWEEDFS_DB_USER=seaweedfs
SEAWEEDFS_DB_PASSWORD=change-me-seaweedfs
