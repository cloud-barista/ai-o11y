# Image version of VictoriaMetrics, vmagent and vmauth.
VM_VERSION=v1.155.0

# Storage: how long samples are kept, and the deduplication interval, which
# must equal the collectors' collection interval so the two copies a vmagent
# failover may write collapse into one.
VM_RETENTION=15d
VM_DEDUP_INTERVAL=30s

# vmagent: disk buffer per storage while that storage is unreachable
# (0 = until the disk is full).
VMAGENT_MAX_DISK_PER_URL=1GB

# Whether OTLP scope metadata (the receiver that produced a series, such as
# scope.name and scope.version) is added to every series as labels.
# VictoriaMetrics' default is true; Prometheus adds none.
VMAGENT_OTLP_SCOPE_LABELS=true

# Host ports of the two entry points (write and query).
VMAUTH_1_PORT=8427
VMAUTH_2_PORT=8428
