# Settings of one storage VM. Each of the two storage VMs runs VictoriaMetrics,
# a vmagent and a vmauth; SELF is this VM, PEER the other one. Copy to
# node.env, fill in and pass to install.sh.

# Release to install (https://github.com/VictoriaMetrics/VictoriaMetrics/releases).
VM_VERSION=v1.155.0

# Addresses the two VMs reach each other at.
SELF_ADDR=10.0.0.11
PEER_ADDR=10.0.0.12

# Where the storage and vmagent's disk buffer live.
DATA_DIR=/var/lib/victoria

# How long samples are kept, and the deduplication interval (the collectors'
# collection interval).
VM_RETENTION=15d
VM_DEDUP_INTERVAL=30s

# vmagent's disk buffer per storage while that storage is unreachable.
VMAGENT_MAX_DISK_PER_URL=1GB

# Whether OTLP scope metadata (the collector component that produced a series
# and its version, scope.name and scope.version) is added to every series as
# labels. Off here, as Prometheus does by default: with it on, a collector
# upgrade changes scope.version and starts new series. VictoriaMetrics' own
# default is on.
VMAGENT_OTLP_SCOPE_LABELS=false

# vmauth accounts: the writer for collectors, the reader for ai-o11y. Change
# the passwords before exposing vmauth anywhere.
VMAUTH_WRITER_USERNAME=writer
VMAUTH_WRITER_PASSWORD=change-me-writer
VMAUTH_READER_USERNAME=reader
VMAUTH_READER_PASSWORD=change-me-reader
