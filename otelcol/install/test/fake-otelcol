#!/usr/bin/env bash
# Fake aio11y-otelcol: `validate --config <file>` fails when the file holds
# INVALID, or reads AIO11Y_WRITE_TOKEN while it is empty, as the collector
# refuses an empty bearer token. FAKE_BUILD names the build, so a test can
# tell which binary is installed.
set -euo pipefail
# build: FAKE_BUILD
[[ ${1:-} == validate && ${2:-} == --config ]] || { echo "fake-otelcol: unexpected $*" >&2; exit 2; }
echo "validate $3" >>"$FAKE_LOG/otelcol.log"
if grep -q 'env:AIO11Y_WRITE_TOKEN' "$3" && [[ -z ${AIO11Y_WRITE_TOKEN:-} ]]; then
  echo "Error: extensions::bearertokenauth: no bearer token provided" >&2
  exit 1
fi
! grep -q INVALID "$3"
